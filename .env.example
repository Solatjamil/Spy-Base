# SpyBase environment variables (copy to .env.local for local dev, or set in Vercel)

# Required for AI analyst (https://openrouter.ai/keys). Free-tier models work great.
OPENROUTER_API_KEY=
# Optional — defaults to google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional: override branding
NEXT_PUBLIC_APP_NAME=SpyBase

# Optional: wire in your own data sources in src/app/api/lookup/route.ts
# BREACH_API_KEY=
# INFOSTEALER_API_KEY=
# WEBHOOK_SECRET=
