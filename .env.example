# =====================================================================
# SpyBase environment variables
# Copy this file to `.env.local` for local dev, or set these in
# Vercel → Settings → Environment Variables. Every key is OPTIONAL —
# if a provider isn't configured, SpyBase simply skips it gracefully.
# See /settings in the UI for a live status view of every key.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_NAME=SpyBase
# Set to "1" to force demo/sample data (for screenshots, previews)
DEMO_MODE=0

# --- AI analyst (OpenRouter) ---
# Required for the AI chat analyst and face/image vision analysis.
# Free-tier models work great — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Defaults to google/gemini-2.0-flash-exp:free (vision-capable).
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Email / breach OSINT ---
# Set any subset you have access to.
HIBP_NO_KEY=1                    # =1 to use free HaveIBeenPwned (rate-limited, no pastes)
HIBP_API_KEY=                    # haveibeenpwned.com paid API key
LEAKCHECK_API_KEY=               # leakcheck.net
LEAKCHECK_KEY_TYPE=key           # "key" (default) or "master"
LEAKCHECKIO_API_KEY=             # leak-check.io / LeaksAPI (infostealer logs + 1800+ DBs)
SNUSBASE_API_KEY=                # snusbase.com
WELEAKINFO_API_KEY=              # weleakinfo.to
INTELX_API_KEY=                  # intelx.io (free tier available) — darknet/pastes/leaks
PSBDMP_API_KEY=                  # psbdmp.cc (paste dumps; public API doesn't need a key)
EMAILREP_API_KEY=                # emailrep.io (free tier available)
HUNTER_API_KEY=                  # hunter.io — verification + enrichment
WHOISXML_API_KEY=                # whoisxmlapi.com (free tier available)
PYPIG_API_KEY=                   # proxycurl / LinkedIn from email
EPLEO_API_KEY=                   # epieos (free tier available)
GRAVATAR_ENABLED=1               # =0 to disable gravatar lookups
ENRICH_FROM_SOCIAL=1             # =0 to disable public account-presence probes

# --- Face / reverse-image OSINT ---
# Strongest single provider: SERPAPI_KEY (uses Google Lens endpoint; free tier ~100/mo)
SERPAPI_KEY=
GOOGLE_CLOUD_VISION_API_KEY=     # WebDetection + face + labels + OCR + logos + landmarks
GOOGLE_CSE_API_KEY=              # Google Custom Search JSON API (alt reverse image)
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=             # Bing Visual Search
TINEYE_API_KEY=                  # tineye.com (exact-match reverse image)
CLARIFAI_API_KEY=                # celebrity/facial recognition model
YANDEX_VISION_API_KEY=           # Yandex Vision (good for CIS-region sources)
SEARCH4FACES_API_KEY=            # search4faces.com — VK/TikTok/Clubhouse avatars
FACECHECK_ID_TOKEN=              # facecheck.id (unofficial session token)
PIMEYES_API_KEY=                 # pimeyes.com premium
PIM_EYES_CSRF=
SOCIALCATFISH_API_KEY=           # socialcatfish.com reverse image
BEENVERIFIED_API_KEY=            # beenverified.com

# --- Admin / owner ---
# Set a password to lock the /settings page (only you are using this).
# Use either ADMIN_PASSWORD (plaintext) or ADMIN_PASSWORD_SHA256 (recommended).
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
# Random long string to sign session cookies.
SESSION_SECRET=please-change-me-to-something-long-and-random
